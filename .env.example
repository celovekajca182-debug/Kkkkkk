# Shared OpenAI-compatible inference gateway (for the chat route, for example HF Router).
SWIN_LLM_BASE_URL=
SWIN_LLM_API_KEY=
SWIN_LLM_TIMEOUT_SECONDS=90

# General chat model/provider (keep this separate from the custom coding adapter).
SWIN_CHAT_BASE_URL=
SWIN_CHAT_API_KEY=
SWIN_CHAT_MODEL=Qwen/Qwen3-4B-Thinking-2507
SWIN_CHAT_MAX_TOKENS=4096
SWIN_CHAT_TEMPERATURE=0.25

# Custom SWIN coder: a dedicated CUDA service must load the base model + PEFT adapter.
SWIN_CODE_BASE_URL=
SWIN_CODE_API_KEY=
SWIN_CODE_MODEL=MAKSIM67771488/SWIN-AI-Coder-Smart
SWIN_CODE_MAX_TOKENS=2400
SWIN_CODE_TEMPERATURE=0.15
