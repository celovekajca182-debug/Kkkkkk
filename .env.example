# OpenAI-compatible GPU inference gateway.
# Leave blank to keep the legacy local SWIN checkpoint active.
# To use Hugging Face Inference Providers, set the shared endpoint and an HF token:
# SWIN_LLM_BASE_URL=https://router.huggingface.co/v1
# SWIN_LLM_API_KEY=hf_your_inference_token
SWIN_LLM_BASE_URL=
SWIN_LLM_API_KEY=
# Optional role-specific endpoints and keys override the shared gateway.
SWIN_CHAT_BASE_URL=
SWIN_CODE_BASE_URL=
SWIN_CHAT_API_KEY=
SWIN_CODE_API_KEY=
SWIN_LLM_TIMEOUT_SECONDS=90

# SWIN routes ordinary chat and code generation to separate models.
SWIN_CHAT_MODEL=Qwen/Qwen3-4B-Thinking-2507
SWIN_CODE_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
SWIN_CHAT_MAX_TOKENS=4096
SWIN_CODE_MAX_TOKENS=2400
SWIN_CHAT_TEMPERATURE=0.25
SWIN_CODE_TEMPERATURE=0.15
